{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "infra: up",
      "type": "shell",
      "command": "docker compose up -d",
      "options": {
        "cwd": "${workspaceFolder}/infra/docker"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "infra: down",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}/infra/docker"
      },
      "problemMatcher": []
    },
    {
      "label": "backend: dev",
      "type": "shell",
      "command": "poetry run uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}